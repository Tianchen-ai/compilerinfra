include_guard(GLOBAL)
include(GNUInstallDirs)
include("${CMAKE_CURRENT_LIST_DIR}/CompilerInfraLayout.cmake")
find_package(Python3 REQUIRED COMPONENTS Interpreter)

# Called once in the unit's source directory. All ownership comes from product.json.
function(compilerinfra_unit)
  cmake_parse_arguments(PARSE_ARGV 0 U "" "" "SOURCES;LINK_LIBRARIES")
  if(NOT ci_target OR U_UNPARSED_ARGUMENTS OR NOT U_SOURCES)
    message(FATAL_ERROR "${CMAKE_CURRENT_LIST_FILE}: expected compilerinfra_unit(SOURCES ... [LINK_LIBRARIES ...])")
  endif()
  if(ci_owner MATCHES "^tools/(.+)$")
    add_executable(${ci_target} ${U_SOURCES})
    set_target_properties(${ci_target} PROPERTIES OUTPUT_NAME "${CMAKE_MATCH_1}")
    install(TARGETS ${ci_target} RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
  else()
    add_library(${ci_target} OBJECT ${U_SOURCES})
  endif()
  set_target_properties(${ci_target} PROPERTIES POSITION_INDEPENDENT_CODE ON CI_UNIT "${ci_unit}"
    CI_OWNER "${ci_owner}" CI_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  target_compile_definitions(${ci_target} PRIVATE CI_UNIT_NAMESPACE=${ci_target})
  target_include_directories(${ci_target} PRIVATE "${ci_package}/include" ${ci_public_includes})
  if(ci_owner MATCHES "^runtime/")
    target_link_libraries(${ci_target} PRIVATE CompilerInfra::Runtime)
  else()
    target_link_libraries(${ci_target} PRIVATE CompilerInfra::Core)
  endif()
  target_link_libraries(${ci_target} PRIVATE ${U_LINK_LIBRARIES})
endfunction()

# Convert a public unit path into a link target without duplicating registration.
function(compilerinfra_target out unit)
  string(HEX "${unit}" hex)
  set(${out} "ci_${hex}" PARENT_SCOPE)
endfunction()

function(compilerinfra_product)
  set(script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tree_build.py")
  set(gen "${CMAKE_CURRENT_BINARY_DIR}/compilerinfra")
  file(MAKE_DIRECTORY "${gen}")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${script}" configure "${CMAKE_CURRENT_SOURCE_DIR}" "${gen}"
    COMMAND_ERROR_IS_FATAL ANY)
  file(READ "${gen}/layout.json" layout)
  string(JSON product GET "${layout}" product name)
  string(JSON packages LENGTH "${layout}" packages)
  math(EXPR last "${packages}-1")
  foreach(i RANGE ${last})
    string(JSON key MEMBER "${layout}" packages ${i})
    string(JSON dir GET "${layout}" packages "${key}")
    list(APPEND ci_public_includes "${dir}/include")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/product.json")
    file(GLOB_RECURSE asset_inputs CONFIGURE_DEPENDS "${dir}/agent/*.py" "${dir}/agent/*.md"
      "${dir}/levels/*/agent/*" "${dir}/exits/*/agent/*" "${dir}/levels/*/CMakeLists.txt"
      "${dir}/exits/*/CMakeLists.txt" "${dir}/runtime/*/CMakeLists.txt")
    if(EXISTS "${dir}/include")
      install(DIRECTORY "${dir}/include/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
    endif()
  endforeach()
  include("${gen}/units.cmake")
  set_property(GLOBAL APPEND PROPERTY CI_TARGETS ${ci_targets})
  get_property(scheduled GLOBAL PROPERTY CI_FINAL_CHECK_SCHEDULED)
  if(NOT scheduled)
    set_property(GLOBAL PROPERTY CI_FINAL_CHECK_SCHEDULED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _ci_verify_units)
  endif()
  add_custom_target(ci_manifest COMMAND "${Python3_EXECUTABLE}" -B "${script}" embed "${CMAKE_CURRENT_SOURCE_DIR}" "${gen}"
    BYPRODUCTS "${gen}/Product.cpp" VERBATIM)
  add_library(${product} SHARED "${gen}/Product.cpp")
  set_target_properties(${product} PROPERTIES CI_PRODUCT_LIBRARY ON INSTALL_RPATH_USE_LINK_PATH ON)
  add_dependencies(${product} ci_manifest)
  target_link_libraries(${product} PRIVATE CompilerInfra::Core)
  foreach(target IN LISTS ci_targets)
    get_target_property(owner ${target} CI_OWNER)
    if(owner MATCHES "^tools/")
      target_link_libraries(${target} PRIVATE ${product})
    else()
      target_link_libraries(${product} PRIVATE ${target})
    endif()
  endforeach()
  # This reference pulls the stable ABI implementation out of the static SDK.
  target_sources(${product} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ProductABI.cpp")
  add_executable(${product}-compile "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Main.cpp")
  target_link_libraries(${product}-compile PRIVATE ${product} CompilerInfra::Runtime)
  set_target_properties(${product}-compile PROPERTIES INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
  install(TARGETS ${product} ${product}-compile LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
  string(JSON n LENGTH "${layout}" assets)
  while(n GREATER 0)
    math(EXPR n "${n}-1")
    string(JSON src GET "${layout}" assets ${n} source)
    string(JSON rel GET "${layout}" assets ${n} path)
    get_filename_component(dir "${rel}" DIRECTORY)
    install(FILES "${src}" DESTINATION "${CMAKE_INSTALL_LIBDIR}/${product}.assets/${dir}")
  endwhile()
endfunction()
