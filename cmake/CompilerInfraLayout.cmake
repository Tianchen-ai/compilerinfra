include_guard(GLOBAL)
set(_compilerinfra_layout_file "${CMAKE_CURRENT_LIST_DIR}/product-layout.json")
# Functions can be called from sibling directories after find_package().
set_property(GLOBAL PROPERTY COMPILERINFRA_LAYOUT_FILE "${_compilerinfra_layout_file}")

function(_compilerinfra_policy out)
  get_property(file GLOBAL PROPERTY COMPILERINFRA_LAYOUT_FILE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
  file(READ "${file}" json)
  set(${out} "${json}" PARENT_SCOPE)
endfunction()

function(_compilerinfra_owner component layer out)
  _compilerinfra_policy(policy)
  string(JSON kind ERROR_VARIABLE error TYPE "${policy}" layers "${layer}")
  if(error)
    message(FATAL_ERROR "${component}: expected LAYER from ${policy} (received '${layer}')")
  endif()
  file(REAL_PATH "${PROJECT_SOURCE_DIR}" root)
  file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}" folder)
  file(RELATIVE_PATH owner "${root}" "${folder}")
  if(NOT owner MATCHES "^${layer}/[a-z][a-z0-9_-]*$")
    message(FATAL_ERROR "${component}: declare the component in ${layer}/<unit>/CMakeLists.txt, found ${owner}")
  endif()
  set(${out} "${owner}" PARENT_SCOPE)
endfunction()

function(_compilerinfra_check_sources component owner)
  foreach(src IN LISTS ARGN)
    file(REAL_PATH "${src}" abs BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
    cmake_path(IS_PREFIX CMAKE_CURRENT_SOURCE_DIR "${abs}" NORMALIZE inside)
    if(NOT inside)
      message(FATAL_ERROR "${component} (${owner}): source outside owning unit: ${src}")
    endif()
  endforeach()
endfunction()

function(_compilerinfra_dependencies component selected out)
  _compilerinfra_policy(policy)
  get_target_property(layer "${component}" COMPILERINFRA_LAYER)
  get_target_property(owner "${component}" COMPILERINFRA_DIRECTORY)
  string(JSON n LENGTH "${policy}" layers "${layer}" depends)
  set(allowed)
  while(n GREATER 0)
    math(EXPR n "${n}-1")
    string(JSON item GET "${policy}" layers "${layer}" depends ${n})
    list(APPEND allowed "${item}")
  endwhile()
  get_target_property(links "${component}" LINK_LIBRARIES)
  set(deps)
  foreach(dep IN LISTS links)
    if(NOT TARGET "${dep}")
      continue()
    endif()
    get_target_property(other "${dep}" COMPILERINFRA_LAYER)
    if(other)
      get_target_property(alias "${dep}" ALIASED_TARGET)
      if(alias)
        set(dep "${alias}")
      endif()
      if(NOT dep IN_LIST selected OR NOT other IN_LIST allowed)
        message(FATAL_ERROR "${owner}/CMakeLists.txt: ${component} (${layer}) cannot link ${dep} (${other}); allowed component layers: ${allowed}")
      endif()
      list(APPEND deps "${dep}")
    endif()
  endforeach()
  set(${out} "${deps}" PARENT_SCOPE)
endfunction()
