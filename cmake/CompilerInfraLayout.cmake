# Validate actual targets after the entire product has configured, including late edits.
function(_ci_links root t)
  list(FIND ARGN "${t}" visited)
  if(NOT visited EQUAL -1)
    return()
  endif()
  get_target_property(owner "${root}" CI_OWNER)
  get_target_property(unit "${root}" CI_UNIT)
  get_target_property(dir "${root}" CI_DIR)
  get_target_property(allowed "${root}" CI_ALLOWED)
  foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_property(links TARGET "${t}" PROPERTY ${property})
    foreach(link IN LISTS links)
      if(link MATCHES "^::@")
        continue()
      endif()
      if(link MATCHES "^\\$<LINK_ONLY:([^$<>]+)>$")
        set(link "${CMAKE_MATCH_1}")
      elseif(link MATCHES "\\$<")
        message(FATAL_ERROR "${dir}/CMakeLists.txt: ${unit}: unresolved link expression on ${t}: ${link}")
      endif()
      if(NOT TARGET "${link}")
        if(link MATCHES "^ci_[0-9a-f]+$" OR link MATCHES "CompilerInfra")
          message(FATAL_ERROR "${dir}/CMakeLists.txt: ${unit}: unresolved dependency ${link}")
        endif()
        continue()
      endif()
      get_target_property(alias "${link}" ALIASED_TARGET)
      if(alias)
        set(link "${alias}")
      endif()
      get_target_property(other "${link}" CI_UNIT)
      get_target_property(product "${link}" CI_PRODUCT_LIBRARY)
      if(product AND NOT owner MATCHES "^tools/")
        message(FATAL_ERROR "${dir}/CMakeLists.txt: ${unit} links the complete product through ${t}")
      elseif(product)
        continue()
      endif()
      if(owner MATCHES "^runtime/" AND (other OR link MATCHES "CompilerInfra.*(Core|Driver|Development)"))
        message(FATAL_ERROR "${dir}/CMakeLists.txt: runtime ${unit} reaches ${link} via ${t}")
      endif()
      if(other AND NOT owner MATCHES "^tools/" AND NOT link STREQUAL root AND NOT link IN_LIST allowed)
        message(FATAL_ERROR "${dir}/CMakeLists.txt: ${unit} may not link ${other} via ${t}")
      endif()
      if(NOT link MATCHES "^CompilerInfra(::)?(Core|Runtime)$")
        _ci_links("${root}" "${link}" ${ARGN} "${t}")
      endif()
    endforeach()
  endforeach()
endfunction()

function(_ci_verify_units)
  get_property(targets DIRECTORY PROPERTY CI_TARGETS)
  foreach(t IN LISTS targets)
    get_target_property(dir ${t} CI_DIR)
    get_target_property(unit ${t} CI_UNIT)
    get_target_property(files ${t} SOURCES)
    foreach(src IN LISTS files)
      if(src MATCHES "\\$<")
        message(FATAL_ERROR "${unit} at ${dir}: unresolved source expression ${src}")
      endif()
      file(REAL_PATH "${src}" path BASE_DIRECTORY "${dir}")
      cmake_path(IS_PREFIX dir "${path}" NORMALIZE inside)
      if(NOT inside)
        message(FATAL_ERROR "${unit} at ${dir}: source outside unit: ${path}")
      endif()
    endforeach()
    _ci_links("${t}" "${t}")
  endforeach()
endfunction()
