@PACKAGE_INIT@
function(compilerinfra_project_name out)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/product.json" declaration)
  string(JSON name GET "${declaration}" name)
  set(${out} "${name}" PARENT_SCOPE)
endfunction()
if(CompilerInfra_FIND_COMPONENTS STREQUAL "Project")
  set(CompilerInfra_Project_FOUND TRUE)
  return()
endif()
include(CMakeFindDependencyMacro)
find_dependency(MLIR @LLVM_VERSION@ EXACT CONFIG)
if(LLVM_ENABLE_ZSTD AND NOT TARGET zstd::libzstd_shared)
  find_library(_ci_zstd_lib NAMES zstd libzstd.so.1)
  if(_ci_zstd_lib)
    add_library(zstd::libzstd_shared SHARED IMPORTED)
    set_target_properties(zstd::libzstd_shared PROPERTIES IMPORTED_LOCATION "${_ci_zstd_lib}")
  else()
    add_library(zstd::libzstd_shared INTERFACE IMPORTED)
  endif()
endif()
set(COMPILERINFRA_LINK_MLIR_DYLIB "@COMPILERINFRA_LINK_MLIR_DYLIB@")
if(NOT COMPILERINFRA_LINK_MLIR_DYLIB AND TARGET LLVMSupport)
  get_property(_ci_imported DIRECTORY PROPERTY IMPORTED_TARGETS)
  foreach(_ci_tgt IN LISTS _ci_imported)
    if(_ci_tgt MATCHES "^MLIR")
      get_target_property(_ci_iface ${_ci_tgt} INTERFACE_LINK_LIBRARIES)
      if(_ci_iface AND "LLVM" IN_LIST _ci_iface)
        list(TRANSFORM _ci_iface REPLACE "^LLVM$" "LLVMCore;LLVMBinaryFormat;LLVMSupport;LLVMDemangle")
        set_target_properties(${_ci_tgt} PROPERTIES INTERFACE_LINK_LIBRARIES "${_ci_iface}")
      endif()
    endif()
  endforeach()
endif()
if(NOT TARGET CompilerInfra::Core)
  include("${CMAKE_CURRENT_LIST_DIR}/CompilerInfraTargets.cmake")
  target_include_directories(CompilerInfra::Core SYSTEM INTERFACE
    ${MLIR_INCLUDE_DIRS} ${LLVM_INCLUDE_DIRS})
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CompilerInfraComponents.cmake")
check_required_components(CompilerInfra)
